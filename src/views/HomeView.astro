---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import WeavingProcess from '@components/sections/landing/WeavingProcess.astro';
import ArtisanStory from '@components/sections/landing/ArtisanStory.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/tenun/hero.webp';
import valuesImage from '@images/tenun/nilai.webp';
import artisanImage from '@images/tenun/pengrajin.webp';
import kainImage from '@images/tenun/koleksi-kain.webp';
import syalImage from '@images/tenun/koleksi-syal.webp';
import dekorasiImage from '@images/tenun/koleksi-dekorasi.webp';
import avatar1 from '@images/tenun/avatar-1.webp';
import avatar2 from '@images/tenun/avatar-2.webp';
import avatar3 from '@images/tenun/avatar-3.webp';
import avatar4 from '@images/tenun/avatar-4.webp';
import type { IconName } from '@components/ui/icons/icons';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * The Tenun Lestari home page in one locale. Section order tells the brand
 * story: the cloth (hero), how it is made (process), why it matters
 * (values, artisans), what to buy (collection), what customers say, the
 * workshops, FAQ and a closing call to action.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

/** One icon per weaving step, in order (copy holds the text). */
const processIcons: IconName[] = ['spool', 'droplet', 'loom', 'leaf'];

/** Woven-pattern avatars for the (sample) review summary in the hero. */
const reviewAvatars = [avatar1, avatar2, avatar3, avatar4];

const testimonials = copy.testimonials.quotes.map(quote => ({
  ...quote,
  avatarSrc: avatar1,
}));
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button-koleksi-2026"
    btnTitle={copy.banner}
    url={localePath(locale, '/products')}
  />

  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={localePath(locale, '/products')}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/contact')}
    withReview={true}
    avatars={reviewAvatars}
    avatarsMore="1k+"
    rating={copy.hero.rating}
    starCount={4}
    reviews={copy.hero.reviews}
    src={heroImage}
    alt={copy.hero.imageAlt}
  />

  <WeavingProcess
    eyebrow={copy.process.eyebrow}
    title={copy.process.title}
    subTitle={copy.process.subTitle}
    steps={copy.process.steps.map((step, index) => ({
      ...step,
      icon: processIcons[index] ?? 'spool',
    }))}
    note={copy.process.note}
  />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={valuesImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <ArtisanStory
    eyebrow={copy.artisans.eyebrow}
    title={copy.artisans.title}
    paragraphs={copy.artisans.paragraphs}
    quote={copy.artisans.quote}
    artisans={copy.artisans.list}
    note={copy.artisans.note}
    src={artisanImage}
    alt={copy.artisans.imageAlt}
    cta={{ title: copy.artisans.cta, url: localePath(locale, '/services') }}
  />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.kain,
        svg: 'loom',
        src: kainImage,
        first: true,
      },
      {
        ...copy.featuresNavs.tabs.syal,
        svg: 'spool',
        src: syalImage,
      },
      {
        ...copy.featuresNavs.tabs.dekorasi,
        svg: 'house',
        src: dekorasiImage,
      },
    ]}
  />

  <TestimonialsSection
    title={copy.testimonials.title}
    subTitle={copy.testimonials.subTitle}
    testimonials={testimonials}
    statistics={copy.testimonials.statistics}
  />

  <PricingSection pricing={t.data.pricing} />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />

  <HeroSectionAlt
    title={copy.heroAlt.title}
    subTitle={copy.heroAlt.subTitle}
    url={localePath(locale, '/products')}
  />
</MainLayout>
