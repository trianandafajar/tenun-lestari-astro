---
/**
 * "Cerita Pengrajin": the artisan story section. An illustration with a
 * pull quote on one side; the story, a row of artisan profile cards and a
 * call to action on the other. All people shown are fictional sample
 * content, which the `note` prop should say.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';

interface Artisan {
  name: string;
  craft: string;
  village: string;
  years: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  paragraphs: string[];
  quote: { content: string; author: string; role: string };
  artisans: Artisan[];
  note?: string;
  src: ImageMetadata;
  alt: string;
  cta?: { title: string; url: string };
  id?: string;
}

const {
  eyebrow,
  title,
  paragraphs,
  quote,
  artisans,
  note,
  src,
  alt,
  cta,
  id = 'cerita-pengrajin',
} = Astro.props;

/** Two-letter monogram, skipping honorifics such as "Ibu" or "Mbok". */
const HONORIFICS = new Set(['ibu', 'bu', 'mbok', 'kak', 'pak', 'bapak']);
const monogram = (name: string) =>
  name
    .split(/\s+/)
    .filter(part => !HONORIFICS.has(part.toLowerCase()))
    .slice(0, 2)
    .map(part => part[0])
    .join('')
    .toUpperCase();
---

<section
  id={id}
  class="mx-auto max-w-[85rem] scroll-mt-28 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    {/* Illustration with the pull quote overlapping it */}
    <div class="relative lg:col-span-5">
      <div class="overflow-hidden rounded-[2rem] ring-1 ring-neutral-300 dark:ring-neutral-700">
        <Image
          src={src}
          alt={alt}
          class="aspect-[6/7] w-full object-cover"
          width={720}
          height={840}
          format="avif"
          loading="lazy"
          draggable="false"
        />
      </div>
      <figure class="relative mx-4 -mt-24 rounded-2xl border-l-4 border-ochre-400 bg-neutral-50 p-6 shadow-xl sm:absolute sm:-right-6 sm:bottom-10 sm:mx-0 sm:mt-0 sm:max-w-xs dark:bg-neutral-900">
        <blockquote>
          <p class="text-lg leading-snug text-pretty text-neutral-800 italic dark:text-neutral-100">
            “{quote.content}”
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm">
          <span class="block font-semibold text-neutral-800 dark:text-neutral-200">
            {quote.author}
          </span>
          <span class="block text-neutral-500 dark:text-neutral-400">
            {quote.role}
          </span>
        </figcaption>
      </figure>
    </div>

    {/* Story, artisan profiles and CTA */}
    <div class="lg:col-span-7">
      {eyebrow && (
        <p class="text-sm font-semibold tracking-[0.2em] text-ochre-700 uppercase dark:text-ochre-300">
          {eyebrow}
        </p>
      )}
      <h2 class="mt-3 text-3xl font-semibold text-balance text-neutral-800 md:text-5xl md:leading-tight dark:text-neutral-100">
        {title}
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400">
        {paragraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {artisans.map(artisan => (
          <li class="flex flex-col rounded-2xl border border-neutral-300 bg-neutral-100 p-5 dark:border-neutral-700 dark:bg-white/5">
            <span
              aria-hidden="true"
              class="font-display inline-flex size-12 items-center justify-center rounded-full bg-nila-700 text-lg text-ochre-200 dark:bg-ochre-300 dark:text-nila-900"
            >
              {monogram(artisan.name)}
            </span>
            <span class="mt-4 font-semibold text-neutral-800 dark:text-neutral-100">
              {artisan.name}
            </span>
            <span class="text-sm text-nila-600 dark:text-ochre-300">
              {artisan.craft}
            </span>
            <span class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
              {artisan.village}
            </span>
            <span class="text-sm text-neutral-500 dark:text-neutral-400">
              {artisan.years}
            </span>
          </li>
        ))}
      </ul>

      {note && (
        <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
          {note}
        </p>
      )}

      {cta && (
        <div class="mt-8">
          <PrimaryCTA title={cta.title} url={cta.url} />
        </div>
      )}
    </div>
  </div>
</section>
