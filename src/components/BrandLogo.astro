---
/**
 * Tenun Lestari logo: a woven "anyaman" diamond mark next to a stacked
 * serif wordmark. Colours follow the theme (nila/ochre, inverted in dark
 * mode); any attribute passed in (e.g. `class`) lands on the `<svg>`.
 */
---

<svg {...Astro.props} viewBox="0 0 330 112" fill="none" role="img">
  <title>Tenun Lestari</title>
  <g transform="translate(56 56) rotate(45)">
    <rect
      x="-38"
      y="-38"
      width="76"
      height="76"
      rx="12"
      class="fill-current text-nila-700 dark:text-ochre-300"
      fill="currentColor"
    ></rect>
    {[-24, -8, 8, 24].flatMap((x, i) =>
      [-24, -8, 8, 24].map((y, j) => (
        <rect
          x={x - 6}
          y={y - 6}
          width="12"
          height="12"
          rx="2.5"
          fill="currentColor"
          class={
            (i + j) % 2 === 0
              ? 'fill-current text-ochre-400 dark:text-nila-800'
              : 'fill-current text-neutral-100 dark:text-neutral-50'
          }
        />
      ))
    )}
  </g>
  <g
    class="fill-current text-nila-900 dark:text-neutral-100"
    fill="currentColor"
    font-family="'Fraunces Variable', Georgia, serif"
  >
    <text x="124" y="50" font-size="44" font-weight="600" letter-spacing="-0.5">
      Tenun
    </text>
    <text
      x="125"
      y="92"
      font-size="31"
      font-weight="400"
      font-style="italic"
      letter-spacing="1.5"
      class="fill-current text-ochre-700 dark:text-ochre-300"
    >
      Lestari
    </text>
  </g>
</svg>
