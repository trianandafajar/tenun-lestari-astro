---
import mark from '@images/starlight/tenun_mark.svg?raw';
import type { Props } from '@astrojs/starlight/props';

/**
 * Docs header title: the Tenun Lestari mark and wordmark (links to the
 * marketing home page) followed by the localised "guide" label (links to
 * the docs landing page of the current docs locale).
 */
const isEnglish = Astro.props.locale === 'en';
const main = isEnglish ? '/en' : '/';
const docs = isEnglish ? '/en/welcome-to-docs/' : '/welcome-to-docs/';
const docsLabel = isEnglish ? 'Care Guide' : 'Panduan';
---

<span class="site-title flex">
  <a class="main-logo flex" href={main} aria-label="Tenun Lestari">
    <span class="mark" set:html={mark} />
    <span class="wordmark">Tenun Lestari</span>
  </a>
  <a class="docs-logo" href={docs}>
    {docsLabel}
  </a>
</span>

<style>
  .site-title {
    gap: 1rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .flex {
    display: flex;
    align-items: center;
  }
  .main-logo {
    gap: 0.5rem;
  }
  .mark :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  .wordmark {
    color: var(--sl-color-white);
    font-family: 'Fraunces Variable', ui-serif, Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .docs-logo {
    color: var(--sl-color-accent);
    font-family: 'Fraunces Variable', ui-serif, Georgia, serif;
    font-size: 1.125rem;
    font-style: italic;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:hover,
  .site-title a:focus-visible {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
